# (اختیاری) اتصال دستیار چت به مدل زبانی واقعی به‌جای پاسخ‌گوی داخلی
# VITE_OPENAI_API_KEY=sk-...
# VITE_OPENAI_BASE_URL=https://api.openai.com/v1
# VITE_AI_MODEL=gpt-4o-mini

# (اختیاری) ارسال فرم تماس به سرویس بیرونی (مثلاً Formspree / وب‌هوک)
# VITE_CONTACT_WEBHOOK=https://formspree.io/f/xxxx
